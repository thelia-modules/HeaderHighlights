<div {{attributes}}>
	{% if desktops|length %}
		<ul class="Hero {% if desktops|length == 2 %}Hero--split{% elseif desktops|length == 1 %}Hero--full{% endif %}">
			{% for block, desktop in desktops %}
				{% set mobile = mobiles[block] %}
				{% set width = block != 1 ? 186 : 414 %}
				{% set height = block != 1 ? 120 : 210 %}
				<li class="Hero-item {{ block == 1 ? 'Hero-item--lead' : 'Hero-item--short' }}">
					<picture class="Hero-image">
						<source media="(min-width: 1024px)" srcset="{{desktop.fileUrl}}">
						<img src="{{mobile.fileUrlMobile}}" alt="{{desktop.headerHighlights.i18ns.title}}" width="{{ width }}" height="{{ height }}">
					</picture>
					<div class="Hero-contain">
						<div class="Hero-title">
							<span class="Hero-desktop">{{ desktop.headerHighlights.i18ns.title  }}</span>
							<span class="Hero-mobile">{{ mobile.headerHighlights.i18ns.title  }}</span>
						</div>
						{% if desktop.headerHighlights.i18ns.catchphrase or mobile.headerHighlights.i18ns.catchphrase %}
							<div class="Hero-desc">
								<span class="Hero-desktop">{{ desktop.headerHighlights.i18ns.catchphrase  }}</span>
								<span class="Hero-mobile">{{ mobile.headerHighlights.i18ns.catchphrase  }}</span>
							</div>
						{% endif %}
						<div class="Hero-desktop">
							{{ component('Molecules:Button:Base', {
								text: desktop.headerHighlights.i18ns.callToAction,
								href: desktop.headerHighlights.i18ns.url,
								icon_right: "chevron-right",
								fill: true,
								size: block == 1 ? "large" : "small"
							}) }}
						</div>
						<div class="Hero-mobile">
							{{ component('Molecules:Button:Base', {
								text: mobile.headerHighlights.i18ns.callToAction,
								href: mobile.headerHighlights.i18ns.url,
								icon_right: "chevron-right",
								fill: true,
								size: block == 1 ? "large" : "small"
							}) }}
						</div>
					</div>
				</li>
			{% endfor %}
		</ul>
	{% endif %}
</div>
